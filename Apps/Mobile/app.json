{
  "expo": {
    "name": "Pocket Monitor",
    "slug": "pocket-monitor",
    "scheme": "pocketmonitor",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0d0d0d",
    "ios": {
      "bundleIdentifier": "com.favdevs.pocketmonitor",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Pocket Monitor uses Bluetooth to find and pair with your Osmo camera.",
        "NSLocalNetworkUsageDescription": "Pocket Monitor talks to your camera over its Wi-Fi to show the live picture.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSBonjourServices": [
          "_pocket-mon._tcp",
          "_opc-mon._tcp"
        ],
        "NSCameraUsageDescription": "Scan a camera Wi-Fi QR code, and read your hand gestures with the front camera when you choose it.",
        "NSMicrophoneUsageDescription": "Hear a double clap to recentre the gimbal while gestures are on. Nothing is recorded.",
        "NSPhotoLibraryAddUsageDescription": "Save clips and stills from your camera to Photos.",
        "NSLocationWhenInUseUsageDescription": "iOS needs location access to read the camera Wi-Fi network name.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "audio"
        ],
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true,
        "com.apple.developer.networking.wifi-info": true,
        "com.apple.security.application-groups": [
          "group.com.favdevs.pocketmonitor"
        ]
      }
    },
    "android": {
      "package": "com.favdevs.pocketmonitor",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          },
          "sitemap": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/sn-pro/400Regular/SNPro_400Regular.ttf",
            "./node_modules/@expo-google-fonts/sn-pro/500Medium/SNPro_500Medium.ttf",
            "./node_modules/@expo-google-fonts/sn-pro/600SemiBold/SNPro_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/sn-pro/700Bold/SNPro_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0d0d0d"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a camera Wi-Fi QR code, and read your hand gestures with the front camera when you choose it.",
          "microphonePermission": "Hear a double clap to recentre the gimbal while gestures are on. Nothing is recorded.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save clips and stills from your camera to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-image",
      "expo-localization",
      "./plugins/with-gles3.js",
      "@bacons/apple-targets",
      "./plugins/with-live-activity-fonts.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
